{
  "name": "quote-of-the-day",
  "version": "1.0.0",
  "private": true,
  "description": "A quote-of-the-day page with a New quote button and persistent favorites.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test --experimental-test-coverage --test-coverage-lines=80 --test-coverage-include='src/**/*.js' 'tests/**/*.test.js'",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "serve": "python3 -m http.server 8000"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9"
  }
}
